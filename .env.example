# Copy to .env and fill in your local values.
# MODELSCOPE_API_KEY=
# INKATLAS_CHAT_MODEL=Qwen/Qwen3.5-35B-A3B

# Directory containing chi_sim.traineddata and eng.traineddata.
# TESSDATA_PREFIX=C:/path/to/tessdata
INKATLAS_OCR_LANG=chi_sim+eng

# Optional UTF-8 literal denylist, one term per line.
# INKATLAS_SENSITIVE_WORDS_FILE=sensitive-words.local.txt

# Optional RAGAS judge (defaults to configured ModelScope or local Ollama).
# INKATLAS_RAGAS_JUDGE_URL=https://api-inference.modelscope.cn/v1
# INKATLAS_RAGAS_JUDGE_MODEL=Qwen/Qwen3.5-35B-A3B
# INKATLAS_RAGAS_JUDGE_KEY=

# Optional embedding service for RAGAS Answer Relevance.
# INKATLAS_RAGAS_EMBED_URL=http://127.0.0.1:11434/v1
# INKATLAS_RAGAS_EMBED_MODEL=bge-m3
# INKATLAS_RAGAS_EMBED_KEY=
